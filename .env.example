# GrowthPilots Environment Configuration
# Copy this file to .env.local for local overrides

# Application Mode
VITE_APP_ENV=development
VITE_APP_NAME="GrowthPilots"
VITE_APP_TAGLINE="Data. Automation. Growth."

# Backend API Base URL (leave empty for local sandbox/mock data mode)
VITE_API_BASE_URL=""

# Optional CRM / Email Webhook for Consultation Form Submissions
# Example: https://hooks.zapier.com/hooks/catch/... or https://api.growthpilots.com/v1/leads
VITE_CONTACT_WEBHOOK_URL=""

# Optional Analytics Tracking
VITE_ANALYTICS_ID=""
